# Copy to .env and fill in. Never commit .env.
DB_NAME=styletrack
DB_USERNAME=styletrack
DB_PASSWORD=change-me-db-password
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
# true = create demo staff, stylists, services and customers on first start
SEED_DEMO=false
SWAGGER_ENABLED=false
PORT=8080
APP_TIMEZONE=Asia/Manila
# Salon QR Ph code shown to customers when paying (public image URL) and the account name on it
QRPH_IMAGE_URL=
QRPH_ACCOUNT_NAME=Jonathan Hair Studio
# Completed visits for Silver / Gold loyal-customer recognition
LOYALTY_SILVER_VISITS=5
LOYALTY_GOLD_VISITS=10
# --- PayMongo online payments (GCash and QR Ph). Leave PAYMONGO_SECRET_KEY empty to switch them off. ---
# Server-side secret key from the PayMongo dashboard (sk_test_... while testing, sk_live_... in production)
PAYMONGO_SECRET_KEY=
# Signing secret shown once when you create the webhook (see README, "Online payments")
PAYMONGO_WEBHOOK_SECRET=
# Public https address of this API, as PayMongo and customers' phones reach it
APP_PUBLIC_URL=http://localhost:8080
